# 복사해서 .env 로 쓰세요:  cp .env.example .env   (.env 는 깃허브에 올리지 마세요)

# ── DB ── 비우면 로컬 SQLite(dev.db). 배포는 Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=
# DATABASE_URL=postgresql://postgres.xxxx:[비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ── 로그인 확인 ── dev: 토큰 없이 통과(로컬) / supabase: 프론트가 보낸 Supabase 토큰 검사(배포)
AUTH_MODE=dev
SUPABASE_URL=
# 예전 방식(HS256) 프로젝트면 JWT Secret 입력, 새 방식(비대칭 키)이면 비워 두기
SUPABASE_JWT_SECRET=

# ── CORS ── 프론트 주소 (쉼표로 여러 개, * 가능)
CORS_ORIGINS=http://localhost:5173,https://*.vercel.app

# ── OCR ── Google Cloud Vision API 키 (월 1,000장 무료)
GOOGLE_VISION_API_KEY=

# ── LLM ── OpenAI 호환 API. 비우면 규칙 기반으로 대신 처리
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai  /  gemini-2.0-flash
# Groq:    https://api.groq.com/openai/v1                           /  llama-3.3-70b-versatile
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# ── 임베딩(RAG) ── 비우면 로컬 n-gram 벡터 (무료)
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
MATCH_AUTO_THRESHOLD=0.78

# ── 마감 알림(Web Push) ── 선택
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=
